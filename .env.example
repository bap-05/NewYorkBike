# MySQL 8.0.16+ (CHECK constraints), database/user must already exist.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=seoul_bike
MYSQL_USER=
MYSQL_PASSWORD=
# Local MySQL: leave empty. Aiven: download the project's CA, use its DNS host,
# and set a PEM path relative to this project (or an absolute path).
MYSQL_SSL_CA=
# Example for Aiven: MYSQL_SSL_CA=certs/aiven-ca.pem

# String IDs from --list-stations (5-10 active NYC stations)
STATION_IDS=

OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_MAX_AGE_SECONDS=3600
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_SECONDS=1

# Applies to Citi Bike GBFS and Open-Meteo only; does not change MySQL connections.
# JSON array: one URL for a provider-managed rotating gateway, multiple URLs for round-robin.
# For a gateway, select rotation per request/connection at your provider (not a sticky session).
# Fill real URLs locally. Percent-encode special characters in usernames/passwords.
OUTBOUND_PROXY_ENABLED=false
OUTBOUND_PROXY_URLS=[]

# Public Citi Bike GBFS discovery; child feed URLs are discovered at runtime.
BIKE_SOURCE=citibike
GBFS_DISCOVERY_URL=https://gbfs.citibikenyc.com/gbfs/gbfs.json
GBFS_STATUS_MAX_AGE_SECONDS=600
GBFS_METADATA_MAX_AGE_SECONDS=86400
DISPLAY_TIMEZONE=America/New_York

# Local raw response archive; relative paths resolve against the project root.
BRONZE_DIR=data/bronze

# Independent Analysis: execute every 5 minutes; expected DATA cadence is separate.
# Collector currently samples :00/:30, so coverage expects 1800 seconds, not 300.
ANALYSIS_EXPECTED_INTERVAL_SECONDS=1800
ANALYSIS_WINDOW_DAYS=7
ANALYSIS_LOW_BIKE_THRESHOLD=3
ANALYSIS_MIN_SAMPLES=2
ANALYSIS_MIN_COVERAGE=0.8
ANALYSIS_INGESTION_GRACE_SECONDS=120

# MySQL 8.0.16+ (CHECK constraints), database/user must already exist.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=seoul_bike
MYSQL_USER=
MYSQL_PASSWORD=
# Local MySQL: leave empty. Aiven: download the project's CA, use its DNS host,
# and set a PEM path relative to this project (or an absolute path).
MYSQL_SSL_CA=
# Physical business tables/columns after migration 0007.
DATABASE_SCHEMA_LANGUAGE=vietnamese
# Example for Aiven: MYSQL_SSL_CA=certs/aiven-ca.pem

# String IDs from --list-stations (5-10 active NYC stations)
STATION_IDS=

OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_MAX_AGE_SECONDS=3600
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_ATTEMPTS=3
HTTP_BACKOFF_SECONDS=1

# Applies to Citi Bike GBFS and Open-Meteo only; does not change MySQL connections.
# JSON array: one URL for a provider-managed rotating gateway, multiple URLs for round-robin.
# For a gateway, select rotation per request/connection at your provider (not a sticky session).
# Fill real URLs locally. Percent-encode special characters in usernames/passwords.
OUTBOUND_PROXY_ENABLED=false
OUTBOUND_PROXY_URLS=[]

# Public Citi Bike GBFS discovery; child feed URLs are discovered at runtime.
BIKE_SOURCE=citibike
GBFS_DISCOVERY_URL=https://gbfs.citibikenyc.com/gbfs/gbfs.json
GBFS_STATUS_MAX_AGE_SECONDS=600
GBFS_METADATA_MAX_AGE_SECONDS=86400
DISPLAY_TIMEZONE=America/New_York

# Local raw response archive; relative paths resolve against the project root.
BRONZE_DIR=data/bronze

# Independent Analysis: execute every 5 minutes; expected DATA cadence is separate.
# Legacy interval before the transitions declared in config/sampling_schedule.json.
# Keep 1800 here: that file switches Citi Bike to 300 seconds from 2026-11-09T11:25Z.
ANALYSIS_EXPECTED_INTERVAL_SECONDS=1800
ANALYSIS_WINDOW_DAYS=7
ANALYSIS_LOW_BIKE_THRESHOLD=3
ANALYSIS_MIN_SAMPLES=2
ANALYSIS_MIN_COVERAGE=0.8
ANALYSIS_INCLUDE_ESTIMATED=true
ANALYSIS_INGESTION_GRACE_SECONDS=120

# Independent Clustering: daily NY calendar; requires 7 completed local days.
# Same versioned schedule as Analysis; historical interval remains 1800 seconds.
# No source API or proxy needed by this worker.
CLUSTERING_EXPECTED_INTERVAL_SECONDS=1800
CLUSTERING_WINDOW_DAYS=7
CLUSTERING_MIN_SAMPLES=200
CLUSTERING_MIN_DAILY_COVERAGE=0.8
CLUSTERING_MIN_STATIONS=6
CLUSTERING_MAX_CLUSTERS=4
CLUSTERING_LOW_BIKE_THRESHOLD=3

# Shared non-secret Analysis/Clustering schedule, relative to the project root.
SAMPLING_SCHEDULE_FILE=config/sampling_schedule.json

# Independent Prediction every 5 minutes; training is a separate explicit command.
# Horizon is anchored to the input observation sampled_at, not to issuance time.
# Keep source freshness at 10 minutes; the sampling history does not change this.
PREDICTION_MAX_BIKE_AGE_SECONDS=600
PREDICTION_TIMESTAMP_TOLERANCE_SECONDS=120
PREDICTION_HISTORY_DAYS=28
PREDICTION_MIN_TRAINING_DAYS=14
PREDICTION_MIN_TRAINING_SAMPLES=1000
PREDICTION_MIN_STATION_SAMPLES=100
PREDICTION_MIN_HOLDOUT_SAMPLES=50


# Public GET endpoints are read-only; operator POST endpoints require a token.
API_SERVICE_TOKEN=
CLUSTERING_MODEL_FILE=artifacts/clustering/model.json
API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
API_BIKE_MAX_AGE_SECONDS=600
API_PREDICTION_MAX_AGE_SECONDS=900
API_MAX_RANGE_DAYS=31
API_EDA_REPORT_DIR=artifacts/eda
# API checks for changed EDA inputs every 15 minutes; web polls completed reports every minute.
EDA_AUTO_UPDATE=true
